// Sentinel schema for HHGOA_IEEE — follows the README's suggested schema, plus case memory.
// Run: gsql schema.gsql
CREATE VERTEX Customer         (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
// transactions.csv has no card_id; a CardProfile here is a customer's card-field profile (card1..card6).
// Case IDs like C01234-K1 (closed cases / case pack) are CaseCard vertices linked to transactions they cite.
CREATE VERTEX CardProfile (PRIMARY_ID id STRING, card4 STRING, card6 STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX CaseCard         (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Transaction      (PRIMARY_ID id STRING, ts DATETIME, amount DOUBLE, product_cd STRING, channel STRING, risk_score DOUBLE, addr1 STRING, device_new BOOL, proxy_type STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX DeviceProfile    (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX EmailDomain      (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX BillingRegion    (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX ClosedCase       (PRIMARY_ID id STRING, outcome STRING, pattern STRING, exposure_usd DOUBLE, actions_taken STRING, report_filed STRING, analyst_notes STRING, opened_at STRING, closed_at STRING) WITH primary_id_as_attribute="true"
// Our investigations (case memory written back by the agent)
CREATE VERTEX InvestigationCase(PRIMARY_ID id STRING, status STRING, verdict STRING, fraud_probability DOUBLE, pattern STRING, pattern_description STRING, exposure_usd DOUBLE, summary STRING, initial_actions STRING, final_actions STRING, sar_filed BOOL, sar_narrative STRING, opened_at STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX PolicyChunk      (PRIMARY_ID id STRING, section STRING, text STRING) WITH primary_id_as_attribute="true"

CREATE DIRECTED EDGE OWNS            (FROM Customer, TO CardProfile) WITH REVERSE_EDGE="OWNED_BY"
CREATE DIRECTED EDGE MADE            (FROM CardProfile, TO Transaction) WITH REVERSE_EDGE="MADE_BY"
CREATE DIRECTED EDGE FROM_DEVICE     (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_OF"
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="EMAIL_OF"
CREATE DIRECTED EDGE BILLED_IN       (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="REGION_OF"
CREATE DIRECTED EDGE NEXT            (FROM Transaction, TO Transaction)
CREATE DIRECTED EDGE INVOLVES        (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="INVOLVED_IN"
CREATE DIRECTED EDGE ON_CARD         (FROM ClosedCase, TO CaseCard)
CREATE DIRECTED EDGE CONNECTED_TO    (FROM ClosedCase, TO CaseCard)
CREATE DIRECTED EDGE CASE_CUSTOMER   (FROM ClosedCase, TO Customer) WITH REVERSE_EDGE="CUSTOMER_CASE"
CREATE DIRECTED EDGE CARD_OF         (FROM CaseCard, TO Customer)
CREATE DIRECTED EDGE FLAGGED         (FROM InvestigationCase, TO Transaction)
CREATE DIRECTED EDGE AFFECTS         (FROM InvestigationCase, TO Transaction)
CREATE DIRECTED EDGE INV_ON_CARD     (FROM InvestigationCase, TO CaseCard)
CREATE DIRECTED EDGE INV_CONNECTED   (FROM InvestigationCase, TO CaseCard)
CREATE DIRECTED EDGE INV_DEVICE      (FROM InvestigationCase, TO DeviceProfile)
CREATE DIRECTED EDGE SIMILAR_TO      (FROM InvestigationCase, TO ClosedCase)

CREATE GRAPH Sentinel (*)
