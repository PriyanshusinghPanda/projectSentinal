// Load ./load_data/*.csv (from prepare_data.py). On Savanna, upload the files and use the same file variables.
USE GRAPH Sentinel
CREATE LOADING JOB load_sentinel FOR GRAPH Sentinel {
  DEFINE FILENAME f_transaction;
  DEFINE FILENAME f_card;
  DEFINE FILENAME f_customer;
  DEFINE FILENAME f_device_profile;
  DEFINE FILENAME f_email_domain;
  DEFINE FILENAME f_billing_region;
  DEFINE FILENAME f_owns;
  DEFINE FILENAME f_made;
  DEFINE FILENAME f_from_device;
  DEFINE FILENAME f_purchaser_email;
  DEFINE FILENAME f_billed_in;
  DEFINE FILENAME f_next;
  DEFINE FILENAME f_closed_case;
  DEFINE FILENAME f_involves;
  DEFINE FILENAME f_on_card;
  DEFINE FILENAME f_connected_to;
  DEFINE FILENAME f_case_customer;
  DEFINE FILENAME f_case_card;
  DEFINE FILENAME f_card_of;
  DEFINE FILENAME f_policy_chunk;
  LOAD f_transaction      TO VERTEX Transaction   VALUES ($0, $1, $2, $3, $4, $5, $6, $7, $8) USING header="false", separator=",", QUOTE="double";
  LOAD f_card             TO VERTEX CardProfile VALUES ($0, $1, $2) USING header="false", separator=",", QUOTE="double";
  LOAD f_customer         TO VERTEX Customer      VALUES ($0) USING header="false", separator=",", QUOTE="double";
  LOAD f_device_profile   TO VERTEX DeviceProfile VALUES ($0) USING header="false", separator=",", QUOTE="double";
  LOAD f_email_domain     TO VERTEX EmailDomain   VALUES ($0) USING header="false", separator=",", QUOTE="double";
  LOAD f_billing_region   TO VERTEX BillingRegion VALUES ($0) USING header="false", separator=",", QUOTE="double";
  LOAD f_owns             TO EDGE OWNS            VALUES ($0, $1) USING header="false", separator=",", QUOTE="double";
  LOAD f_made             TO EDGE MADE            VALUES ($0, $1) USING header="false", separator=",", QUOTE="double";
  LOAD f_from_device      TO EDGE FROM_DEVICE     VALUES ($0, $1) USING header="false", separator=",", QUOTE="double";
  LOAD f_purchaser_email  TO EDGE PURCHASER_EMAIL VALUES ($0, $1) USING header="false", separator=",", QUOTE="double";
  LOAD f_billed_in        TO EDGE BILLED_IN       VALUES ($0, $1) USING header="false", separator=",", QUOTE="double";
  LOAD f_next             TO EDGE NEXT            VALUES ($0, $1) USING header="false", separator=",", QUOTE="double";
  LOAD f_closed_case      TO VERTEX ClosedCase    VALUES ($0, $1, $2, $3, $4, $5, $6, $7, $8) USING header="false", separator=",", QUOTE="double";
  LOAD f_involves         TO EDGE INVOLVES        VALUES ($0, $1) USING header="false", separator=",", QUOTE="double";
  LOAD f_case_card        TO VERTEX CaseCard      VALUES ($0) USING header="false", separator=",", QUOTE="double";
  LOAD f_on_card          TO EDGE ON_CARD         VALUES ($0, $1) USING header="false", separator=",", QUOTE="double";
  LOAD f_connected_to     TO EDGE CONNECTED_TO    VALUES ($0, $1) USING header="false", separator=",", QUOTE="double";
  LOAD f_case_customer    TO EDGE CASE_CUSTOMER   VALUES ($0, $1) USING header="false", separator=",", QUOTE="double";
  LOAD f_card_of          TO EDGE CARD_OF         VALUES ($0, $1) USING header="false", separator=",", QUOTE="double";
  LOAD f_policy_chunk     TO VERTEX PolicyChunk   VALUES ($0, $1, $2) USING header="false", separator=",", QUOTE="double";
}
// Community Edition (run from this folder), e.g.:
// RUN LOADING JOB load_sentinel USING f_transaction="./load_data/transaction.csv", f_card="./load_data/card.csv", f_customer="./load_data/customer.csv",
//   f_device_profile="./load_data/device_profile.csv", f_email_domain="./load_data/email_domain.csv", f_billing_region="./load_data/billing_region.csv",
//   f_owns="./load_data/owns.csv", f_made="./load_data/made.csv", f_from_device="./load_data/from_device.csv", f_purchaser_email="./load_data/purchaser_email.csv",
//   f_billed_in="./load_data/billed_in.csv", f_next="./load_data/next.csv", f_closed_case="./load_data/closed_case.csv", f_involves="./load_data/involves.csv",
//   f_on_card="./load_data/on_card.csv", f_connected_to="./load_data/connected_to.csv", f_case_customer="./load_data/case_customer.csv",
//   f_case_card="./load_data/case_card.csv", f_card_of="./load_data/card_of.csv", f_policy_chunk="./load_data/policy_chunk.csv"
