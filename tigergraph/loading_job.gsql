// Load ./load_data/*.csv (from prepare_data.py). On Savanna, upload the files and use the same file variables.
USE GRAPH Sentinel
CREATE LOADING JOB load_sentinel FOR GRAPH Sentinel {
  DEFINE FILENAME f_transaction, f_card, f_customer, f_device_profile, f_email_domain, f_billing_region,
                  f_owns, f_made, f_from_device, f_purchaser_email, f_billed_in, f_next,
                  f_closed_case, f_involves, f_on_card, f_connected_to, f_case_customer, f_case_card, f_card_of, f_policy_chunk;
  LOAD f_transaction      TO VERTEX Transaction   VALUES ($"id", $"ts", $"amount", $"product_cd", $"channel", $"risk_score", $"addr1", $"device_new", $"proxy") USING header="true", separator=",", QUOTE="double";
  LOAD f_card             TO VERTEX Card          VALUES ($"id", $"card4", $"card6") USING header="true", separator=",", QUOTE="double";
  LOAD f_customer         TO VERTEX Customer      VALUES ($"id") USING header="true", separator=",", QUOTE="double";
  LOAD f_device_profile   TO VERTEX DeviceProfile VALUES ($"id") USING header="true", separator=",", QUOTE="double";
  LOAD f_email_domain     TO VERTEX EmailDomain   VALUES ($"id") USING header="true", separator=",", QUOTE="double";
  LOAD f_billing_region   TO VERTEX BillingRegion VALUES ($"id") USING header="true", separator=",", QUOTE="double";
  LOAD f_owns             TO EDGE OWNS            VALUES ($"from", $"to") USING header="true", separator=",", QUOTE="double";
  LOAD f_made             TO EDGE MADE            VALUES ($"from", $"to") USING header="true", separator=",", QUOTE="double";
  LOAD f_from_device      TO EDGE FROM_DEVICE     VALUES ($"from", $"to") USING header="true", separator=",", QUOTE="double";
  LOAD f_purchaser_email  TO EDGE PURCHASER_EMAIL VALUES ($"from", $"to") USING header="true", separator=",", QUOTE="double";
  LOAD f_billed_in        TO EDGE BILLED_IN       VALUES ($"from", $"to") USING header="true", separator=",", QUOTE="double";
  LOAD f_next             TO EDGE NEXT            VALUES ($"from", $"to") USING header="true", separator=",", QUOTE="double";
  LOAD f_closed_case      TO VERTEX ClosedCase    VALUES ($"id", $"outcome", $"pattern", $"exposure_usd", $"actions_taken", $"report_filed", $"analyst_notes", $"opened_at", $"closed_at") USING header="true", separator=",", QUOTE="double";
  LOAD f_involves         TO EDGE INVOLVES        VALUES ($"from", $"to") USING header="true", separator=",", QUOTE="double";
  LOAD f_case_card        TO VERTEX CaseCard      VALUES ($"id") USING header="true", separator=",", QUOTE="double";
  LOAD f_on_card          TO EDGE ON_CARD         VALUES ($"from", $"to") USING header="true", separator=",", QUOTE="double";
  LOAD f_connected_to     TO EDGE CONNECTED_TO    VALUES ($"from", $"to") USING header="true", separator=",", QUOTE="double";
  LOAD f_case_customer    TO EDGE CASE_CUSTOMER   VALUES ($"from", $"to") USING header="true", separator=",", QUOTE="double";
  LOAD f_card_of          TO EDGE CARD_OF         VALUES ($"from", $"to") USING header="true", separator=",", QUOTE="double";
  LOAD f_policy_chunk     TO VERTEX PolicyChunk   VALUES ($"id", $"section", $"text") USING header="true", separator=",", QUOTE="double";
}
// Community Edition (run from this folder), e.g.:
// RUN LOADING JOB load_sentinel USING f_transaction="./load_data/transaction.csv", f_card="./load_data/card.csv", f_customer="./load_data/customer.csv",
//   f_device_profile="./load_data/device_profile.csv", f_email_domain="./load_data/email_domain.csv", f_billing_region="./load_data/billing_region.csv",
//   f_owns="./load_data/owns.csv", f_made="./load_data/made.csv", f_from_device="./load_data/from_device.csv", f_purchaser_email="./load_data/purchaser_email.csv",
//   f_billed_in="./load_data/billed_in.csv", f_next="./load_data/next.csv", f_closed_case="./load_data/closed_case.csv", f_involves="./load_data/involves.csv",
//   f_on_card="./load_data/on_card.csv", f_connected_to="./load_data/connected_to.csv", f_case_customer="./load_data/case_customer.csv",
//   f_case_card="./load_data/case_card.csv", f_card_of="./load_data/card_of.csv", f_policy_chunk="./load_data/policy_chunk.csv"
